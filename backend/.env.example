PORT=3000
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_AUTH=true
SMTP_USER=your@gmail.com
SMTP_PASS=your_app_password

# Optional. Defaults to SMTP_USER when omitted.
MAIL_FROM=your@gmail.com
MAIL_TO=your@gmail.com
MAIL_SUBJECT=Query From Website - Updated

# Optional transport settings.
SMTP_CONNECTION_TIMEOUT=15000
SMTP_GREETING_TIMEOUT=15000
SMTP_SOCKET_TIMEOUT=20000
SMTP_LOGGER=false
SMTP_DEBUG=false

# For an SMTP relay that does not require login, use SMTP_AUTH=false.
# SMTP_USER and SMTP_PASS may then be omitted if MAIL_FROM and MAIL_TO are set.
